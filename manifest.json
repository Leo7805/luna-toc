{
    "manifest_version": 3,
    "name": "LunaTOC-SC - ChatGPT 对话目录",
    "short_name": "LunaTOC-SC",
    "version": "1.13.35",
    "description": "LunaTOC-SC：为 ChatGPT 长对话添加中文目录、回答标题导航和本地提示词库。",
    "icons": {
        "16": "src/icons/icon16.png",
        "32": "src/icons/icon32.png",
        "48": "src/icons/icon48.png",
        "128": "src/icons/icon128.png"
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "src/icons/icon16.png",
            "32": "src/icons/icon32.png",
            "48": "src/icons/icon48.png"
        }
    },
    "options_ui": {
        "page": "src/options/options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "permissions": [
        "storage",
        "webRequest"
    ],
    "host_permissions": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*"
            ],
            "js": [
                "src/pageHook/pageHook.iife.ts"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*"
            ],
            "js": [
                "src/content.ts"
            ],
            "css": [
                "src/styles/content.css"
            ],
            "run_at": "document_start",
            "world": "ISOLATED"
        }
    ]
}
