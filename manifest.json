{
    "manifest_version": 3,
    "name": "ChatGPT 对话目录 - LunaTOC",
    "short_name": "LunaTOC",
    "version": "1.13.2",
    "description": "为 ChatGPT 长对话添加目录、提示词导航和「我的提示词」侧边栏。",
    "icons": {
        "16": "src/icons/icon16.png",
        "32": "src/icons/icon32.png",
        "48": "src/icons/icon48.png",
        "128": "src/icons/icon128.png"
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "src/icons/icon16.png",
            "32": "src/icons/icon32.png",
            "48": "src/icons/icon48.png"
        }
    },
    "options_ui": {
        "page": "src/options/options.html",
        "open_in_tab": true
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*"
            ],
            "js": [
                "src/pageHook/pageHook.iife.ts"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*"
            ],
            "js": [
                "src/content.ts"
            ],
            "css": [
                "src/styles/content.css"
            ],
            "run_at": "document_start",
            "world": "ISOLATED"
        }
    ],
    "version_name": "1.13.2-d17"
}
