{
  "manifest_version": 3,
  "name": "ChatGPT Table of Contents - LunaTOC",
  "short_name": "LunaTOC",
  "version": "1.6.3",
  "description": "Add a table of contents, prompt navigator, and MyPrompts sidebar to long ChatGPT conversations.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "src/features/outline.js",
        "src/features/follow.js",
        "src/features/message.js",
        "src/features/promptMark.js",
        "src/features/jump.js",
        "src/features/tooltip.js",
        "src/features/toggleButton.js",
        "src/features/sidebarVisibility.js",
        "src/features/promptStore.js",
        "src/features/myPrompts.js",
        "content.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/page/pageHook.js"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
